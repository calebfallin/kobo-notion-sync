# Copy to kobo-sync.env and fill in after deploying the worker.
# Get the URL with:  ntn workers webhooks list   (look for the koboSync entry)
# The secret must match the KOBO_SYNC_SECRET pushed to the worker env.

KOBO_WEBHOOK_URL="https://www.notion.so/webhooks/worker/.../koboSync"
KOBO_SYNC_SECRET="paste-the-same-secret-here"

# Optional: override the Kobo mount point if auto-detection fails.
# KOBO_MOUNT="/Volumes/KOBOeReader"

# Optional: set to 0 to keep the Kobo mounted at the end of a sync (default 1 =
# eject every run, then pop a "safe to unplug" notification).
# KOBO_AUTO_EJECT=1

# Optional: sound for the completion notification. Any name from
# /System/Library/Sounds (e.g. Glass, Ping, Hero). Set empty to silence.
# KOBO_NOTIFY_SOUND="Glass"

# Optional: timestamped backups of the Kobo DB into ./backups on every sync.
# KOBO_BACKUP=1            # set 0 to disable
# KOBO_BACKUP_KEEP=30      # how many to retain (0 = keep all)
